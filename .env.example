# Contact form email delivery (Resend — https://resend.com)
# Without RESEND_API_KEY and CONTACT_FROM_EMAIL the form shows an honest
# "sending unavailable, write to office@anami.rs" message instead of sending.
RESEND_API_KEY=
# Sender must be on a domain verified in Resend (e.g. anami.rs)
CONTACT_FROM_EMAIL="ANAMI web <web@anami.rs>"
# Recipient (defaults to office@anami.rs)
CONTACT_TO_EMAIL=office@anami.rs

# Signs the contact form anti-spam ticket. Any long random string, e.g.:
#   node -e "console.log(require(\"crypto\").randomBytes(32).toString(\"base64url\"))"
CONTACT_FORM_SECRET=
